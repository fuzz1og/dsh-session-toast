{
  "name": "dsh-session-toast",
  "version": "0.1.0",
  "description": "DSH host plugin: real Windows system notifications for session turn end, errors, aborts, agent questions, pending approvals and blocked goals. Zero runtime dependencies and no @deepseek-ai/dsh-* peerDependencies, so the 0.2.0 kernel version gate never applies.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/toast-smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "notification",
    "toast",
    "windows",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fuzz1og/dsh-session-toast.git"
  },
  "author": "fuzz1og"
}
